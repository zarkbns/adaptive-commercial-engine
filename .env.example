# =============================================================================
# A.C.E (Adaptive Commercial Engine) Environment Variables Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AI & LLM Model Secrets (REQUIRED)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI models and intent gating.
# In Google AI Studio, this is automatically injected or provided in User Secrets.
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# 2. Application Host Configuration (SAFE DEFAULTS)
# -----------------------------------------------------------------------------
# APP_URL: Base URL where this application is hosted.
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 3. HydraDB OSS Graph Substrate Configuration
# -----------------------------------------------------------------------------
# HYDRADB_URL: HydraDB OSS OpenCypher Graph Query Endpoint (:8443)
# - Inside Docker Compose network: http://hydradb:8443
# - On Local Host machine:        http://localhost:8443
# - Remote/Cloud Managed:         https://your-hydradb-instance:8443
HYDRADB_URL="http://hydradb:8443"

# HYDRADB_ADMIN_URL: HydraDB OSS Admin and Readiness Probe Endpoint (:9090)
# - Inside Docker Compose network: http://hydradb:9090
# - On Local Host machine:        http://localhost:9090
# - Remote/Cloud Managed:         https://your-hydradb-instance:9090
HYDRADB_ADMIN_URL="http://hydradb:9090"

# HYDRADB_GRAPH_ID: Target graph identifier in HydraDB (default: 'default')
HYDRADB_GRAPH_ID="default"

# HYDRADB_NAMESPACE: Graph namespace header for multi-tenancy (default: 'default')
HYDRADB_NAMESPACE="default"

# HYDRADB_API_KEY: Bearer authentication token for HydraDB OSS instance.
# Generated automatically during 'bash scripts/init-hydradb.sh' (openssl rand -hex 32).
HYDRADB_API_KEY=""
