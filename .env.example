# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# HYDRADB_URL: HydraDB OSS Local or Container Instance endpoint
# When running inside Docker Compose: http://hydradb:8443
# When running on host machine: http://localhost:8443
HYDRADB_URL="http://localhost:8443"

# HYDRADB_GRAPH_ID: Target graph identifier in HydraDB (default: 'default')
HYDRADB_GRAPH_ID="default"

# HYDRADB_NAMESPACE: Graph namespace header for multi-tenancy (default: 'default')
HYDRADB_NAMESPACE="default"

# HYDRADB_API_KEY: Optional Bearer authentication key for HydraDB instance (leave empty for local dev)
HYDRADB_API_KEY=""
