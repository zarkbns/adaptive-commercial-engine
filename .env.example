# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# HYDRADB_URL: HydraDB OSS Local or Container Instance endpoint
# When running standalone on host: http://localhost:8000 (or http://localhost:8443)
# When running inside Docker Compose: http://hydradb:8000
HYDRADB_URL="http://localhost:8000"

# HYDRADB_API_KEY: Optional authentication key for HydraDB instance (leave empty for local OSS)
HYDRADB_API_KEY=""

# HYDRADB_DATABASE: Target database / graph namespace in HydraDB (e.g. 'ace')
HYDRADB_DATABASE="ace"
