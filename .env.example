# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# User ID and Group ID for HydraDB OSS container volume permissions
HOST_UID="1000"
HOST_GID="1000"

# HYDRADB_URL: HydraDB OSS OpenCypher Graph Query Endpoint (:8443)
# When running inside Docker Compose: http://hydradb:8443
# When running on host machine: http://localhost:8443
HYDRADB_URL="http://localhost:8443"

# HYDRADB_ADMIN_URL: HydraDB OSS Admin/Readiness Endpoint (:9090)
# When running inside Docker Compose: http://hydradb:9090
# When running on host machine: http://localhost:9090
HYDRADB_ADMIN_URL="http://localhost:9090"

# HYDRADB_GRAPH_ID: Target graph identifier in HydraDB (default: 'default')
HYDRADB_GRAPH_ID="default"

# HYDRADB_NAMESPACE: Graph namespace header for multi-tenancy (default: 'default')
HYDRADB_NAMESPACE="default"

# HYDRADB_API_KEY: Bearer authentication token for HydraDB OSS instance (>= 32 chars, generated via openssl rand -hex 32)
HYDRADB_API_KEY="your-secure-random-32-byte-token-here"
